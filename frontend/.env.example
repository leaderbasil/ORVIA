VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_CURRENCY_CODE=USD

# Frontend-only showcase demo. When unset (or true) the login page shows the
# one-click demo button and all demo data lives in the browser; no backend or
# database is required. Set to false to hide the button in a real deployment.
VITE_DEMO_LOGIN_ENABLED=true
# Optional overrides. The defaults below are safe because demo auth never
# reaches the API and the values are compiled into the public bundle.
VITE_DEMO_ADMIN_EMAIL=abc@orvia.com
VITE_DEMO_ADMIN_PASSWORD="ORVIA2026@#$"
