# Copy this file to .env and fill real values. Never commit .env.
APP_ENV=development
APP_NAME=ORVIA
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mini_grocery_pos
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mini_grocery_pos_test

# Must be a long random string (>= 32 characters). Required, no default.
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

FRONTEND_ORIGIN=http://localhost:5173

TAX_RATE=0.00
CURRENCY_CODE=USD
REPORT_TIMEZONE=UTC

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-now
FIRST_ADMIN_FULL_NAME=Store Admin

# Optional: `python -m scripts.seed_demo` uses these when creating a demo cashier.
# Leave DEMO_CASHIER_PASSWORD empty to use the first active admin as the seller.
DEMO_CASHIER_EMAIL=cashier@example.com
DEMO_CASHIER_PASSWORD=
DEMO_CASHIER_FULL_NAME=Demo Cashier
